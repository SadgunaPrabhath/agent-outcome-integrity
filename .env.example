# Copy to .env and adjust. Never commit real secrets.

# AOIE persistence (SQLite for the MVP; Postgres is a hardening follow-up).
AOIE_DB_URL=sqlite:///aoie.db

# Demo app persistence file (its own SQLite, separate from AOIE's DB).
AOIE_DEMO_DB=demo_app.sqlite

# Dashboard -> API base URL (used by apps/dashboard at build/runtime).
NEXT_PUBLIC_API_BASE=http://localhost:8000
